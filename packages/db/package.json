{
  "name": "@openkb/db",
  "private": true,
  "version": "0.3.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed-dev": {
      "types": "./dist/seed-dev.d.ts",
      "default": "./dist/seed-dev.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed:first-admin": "tsx src/seed-first-admin.cli.ts",
    "db:test": "vitest run --config vitest.db.config.ts",
    "dev:seed": "tsx src/seed-dev.cli.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openkb/markdown": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "prisma": "^6.19.0"
  }
}
