generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  password_hash     String?
  display_name      String
  status            String
  email_verified_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("users")
}

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("tenants")
}

model TenantMembership {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  role       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, user_id])
  @@index([user_id])
  @@map("tenant_memberships")
}

model AuthSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  user_id       String    @db.Uuid
  token_hash    String    @unique
  expires_at    DateTime  @db.Timestamptz(6)
  revoked_at    DateTime? @db.Timestamptz(6)
  last_seen_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([user_id])
  @@index([expires_at])
  @@map("auth_sessions")
}

model AuthToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  user_id     String    @db.Uuid
  purpose     String
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([user_id])
  @@index([purpose])
  @@map("auth_tokens")
}

model AuthEmailOutbox {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String?   @db.Uuid
  user_id     String?   @db.Uuid
  to_email    String
  template    String
  subject     String
  link_url    String?
  payload     Json      @default("{}")
  status      String    @default("pending")
  error       String?
  attempts    Int       @default(0)
  last_attempt_at DateTime? @db.Timestamptz(6)
  sent_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([user_id])
  @@index([to_email])
  @@map("auth_email_outbox")
}

model SmtpSetting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope              String   @unique @default("instance")
  enabled            Boolean  @default(false)
  host               String?
  port               Int?
  secure             Boolean  @default(true)
  username           String?
  from_email         String?
  reply_to           String?
  encrypted_password String?
  password_last4     String?
  updated_by         String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("smtp_settings")
}

model AuthSetting {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String?  @db.Uuid
  registration_enabled       Boolean  @default(true)
  email_verification_required Boolean  @default(true)
  default_signup_status      String   @default("active")
  invited_user_auto_active   Boolean  @default(true)
  allowed_email_domains      String[]
  invite_required            Boolean  @default(false)
  first_user_becomes_admin   Boolean  @default(true)
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@map("auth_settings")
}

model Group {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, name])
  @@map("groups")
}

model GroupMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([group_id, user_id])
  @@index([tenant_id])
  @@index([user_id])
  @@map("group_members")
}

model Workspace {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  slug       String
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, slug])
  @@index([created_by])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  role         String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([workspace_id, user_id])
  @@index([tenant_id])
  @@index([user_id])
  @@map("workspace_members")
}

model KnowledgeBase {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  workspace_id String   @db.Uuid
  title        String
  slug         String
  visibility   String
  status       String
  created_by   String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([workspace_id, slug])
  @@index([tenant_id])
  @@index([created_by])
  @@map("knowledge_bases")
}

model KnowledgeBaseChunkSetting {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String   @db.Uuid
  workspace_id               String   @db.Uuid
  knowledge_base_id          String   @unique @db.Uuid
  mode                       String   @default("parent_child")
  doc_form                   String   @default("hierarchical_model")
  indexing_technique         String   @default("high_quality")
  process_rule_mode          String   @default("hierarchical")
  process_rule               Json     @default("{}")
  retrieval_model            Json     @default("{}")
  summary_index_setting      Json     @default("{}")
  parent_mode                String   @default("paragraph")
  parent_delimiter           String   @default("\n\n")
  child_delimiter            String   @default("\n\n")
  parent_max_characters      Int      @default(4000)
  child_max_characters       Int      @default(900)
  child_overlap_characters   Int      @default(120)
  revision                   Int      @default(1)
  updated_by                 String   @db.Uuid
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([workspace_id])
  @@map("knowledge_base_chunk_settings")
}

model KnowledgeBaseMetadataField {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  name              String
  type              String
  status            String   @default("active")
  sort_order        Int      @default(0)
  created_by        String   @db.Uuid
  updated_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([knowledge_base_id, name])
  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@map("knowledge_base_metadata_fields")
}

model Document {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  parent_id         String?  @db.Uuid
  type              String
  title             String
  slug              String
  status            String
  permission_mode   String   @default("inherit")
  visibility        String?
  current_version_id String? @db.Uuid
  sort_order        Int      @default(0)
  doc_form          String?
  process_rule_snapshot Json @default("{}")
  processing_status String   @default("current")
  processing_revision Int    @default(1)
  doc_language      String?
  need_summary      Boolean  @default(false)
  created_by        String   @db.Uuid
  updated_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([parent_id])
  @@map("documents")
}

model DocumentMetadataValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  document_id       String   @db.Uuid
  field_id          String   @db.Uuid
  value             Json
  updated_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([document_id, field_id])
  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([field_id])
  @@map("document_metadata_values")
}

model DocumentAsset {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  document_id     String?  @db.Uuid
  object_key      String
  filename        String
  mime_type       String
  size_bytes      BigInt
  checksum_sha256 String?
  storage_bucket  String   @default("openkb-assets")
  metadata        Json     @default("{}")
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([document_id])
  @@index([checksum_sha256])
  @@map("document_assets")
}

model DocumentVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  document_id    String   @db.Uuid
  version_no     Int
  markdown       String
  markdown_hash  String
  source_type    String
  source_file_id String?  @db.Uuid
  created_by     String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([document_id, version_no])
  @@index([tenant_id])
  @@index([source_file_id])
  @@map("document_versions")
}

model Collaborator {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  object_type  String
  object_id    String   @db.Uuid
  subject_type String
  subject_id   String   @db.Uuid
  role         String
  source       String
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([object_type, object_id, subject_type, subject_id])
  @@index([tenant_id])
  @@index([subject_type, subject_id])
  @@map("collaborators")
}

model Invitation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  object_type     String
  object_id       String   @db.Uuid
  email           String?
  invited_user_id String?  @db.Uuid
  role            String
  token_hash      String
  status          String
  require_approval Boolean @default(false)
  approved_by     String? @db.Uuid
  invited_by      String  @db.Uuid
  expires_at      DateTime? @db.Timestamptz(6)
  max_uses        Int?
  used_count      Int     @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([token_hash])
  @@index([object_type, object_id])
  @@map("invitations")
}

model ShareLink {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                     String    @db.Uuid
  object_type                   String
  object_id                     String    @db.Uuid
  token_hash                    String
  permission                    String    @default("view")
  password_hash                 String?
  require_login                 Boolean   @default(false)
  restrict_to_workspace_members Boolean   @default(false)
  expires_at                    DateTime? @db.Timestamptz(6)
  revoked_at                    DateTime? @db.Timestamptz(6)
  created_by                    String    @db.Uuid
  created_at                    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([token_hash])
  @@index([object_type, object_id])
  @@map("share_links")
}

model ImportJob {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  workspace_id       String   @db.Uuid
  knowledge_base_id  String   @db.Uuid
  parent_id          String?  @db.Uuid
  source_asset_id    String   @db.Uuid
  status             String
  converter          String
  title              String?
  document_id        String?  @db.Uuid
  output_version_id  String?  @db.Uuid
  error              String?
  warnings           Json     @default("[]")
  metadata           Json     @default("{}")
  created_by         String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  finished_at        DateTime? @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([status])
  @@index([document_id])
  @@map("import_jobs")
}

model DocumentChunk {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  document_id       String   @db.Uuid
  version_id        String   @db.Uuid
  ordinal           Int
  chunk_type        String   @default("general")
  parent_chunk_id   String?  @db.Uuid
  settings_revision Int      @default(1)
  start_line        Int?
  end_line          Int?
  start_char        Int?
  end_char          Int?
  parent_ordinal    Int?
  child_ordinal     Int?
  heading_path      String[] @default([])
  content_text      String
  content_markdown  String
  token_count       Int?
  metadata          Json     @default("{}")
  index_role        String   @default("content")
  source_chunk_id   String?  @db.Uuid
  status            String   @default("active")
  override_content_text String?
  override_content_markdown String?
  overridden_by     String?  @db.Uuid
  overridden_at     DateTime? @db.Timestamptz(6)
  disabled_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([version_id, ordinal])
  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([document_id])
  @@index([parent_chunk_id])
  @@index([chunk_type])
  @@index([index_role])
  @@index([source_chunk_id])
  @@map("document_chunks")
}

model DocumentQaPair {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  document_id       String   @db.Uuid
  question          String
  answer            String
  source_chunk_id   String?  @db.Uuid
  source            String   @default("manual")
  status            String   @default("active")
  metadata          Json     @default("{}")
  created_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([document_id])
  @@index([source_chunk_id])
  @@index([status])
  @@map("document_qa_pairs")
}

model DocumentSummary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  document_id       String   @db.Uuid
  summary           String
  status            String   @default("active")
  metadata          Json     @default("{}")
  created_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([document_id])
  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([document_id])
  @@index([status])
  @@map("document_summaries")
}

model DocumentSegmentSummary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  workspace_id      String   @db.Uuid
  knowledge_base_id String   @db.Uuid
  document_id       String   @db.Uuid
  chunk_id          String   @db.Uuid
  summary           String
  status            String   @default("active")
  metadata          Json     @default("{}")
  created_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([chunk_id])
  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([document_id])
  @@index([status])
  @@map("document_segment_summaries")
}

model ChunkRebuildJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String    @db.Uuid
  workspace_id      String    @db.Uuid
  knowledge_base_id String    @db.Uuid
  settings_revision Int
  status            String
  requested_by      String    @db.Uuid
  error             String?
  metadata          Json      @default("{}")
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  finished_at       DateTime? @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([workspace_id])
  @@index([knowledge_base_id])
  @@index([status])
  @@map("chunk_rebuild_jobs")
}

model MilvusIndexProfile {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String?   @db.Uuid
  alias                   String
  collection_name         String
  schema_version          String
  vector_dim              Int
  embedding_function_name String
  bm25_function_name      String?
  rerank_function_name    String?
  status                  String
  function_metadata       Json      @default("{}")
  created_by              String    @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  activated_at            DateTime? @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([alias])
  @@map("milvus_index_profiles")
}

model IndexRebuildJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String?   @db.Uuid
  target_collection String
  target_alias      String
  status            String
  started_by        String    @db.Uuid
  started_at        DateTime  @default(now()) @db.Timestamptz(6)
  finished_at       DateTime? @db.Timestamptz(6)
  error             String?

  @@index([tenant_id])
  @@index([status])
  @@map("index_rebuild_jobs")
}

model RetrievalSetting {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String?  @unique @db.Uuid
  mode       String
  updated_by String   @db.Uuid
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@map("retrieval_settings")
}

model ModelSetting {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String?  @db.Uuid
  kind                  String   @unique
  provider              String
  endpoint              String?
  model                 String?
  enabled               Boolean  @default(false)
  timeout_ms            Int?
  embedding_dim         Int?
  embedding_batch_size  Int?
  llm_temperature       Float?
  llm_max_output_tokens Int?
  encrypted_api_key     String?
  api_key_last4         String?
  capabilities          Json      @default("{}")
  capabilities_detected_at DateTime? @db.Timestamptz(6)
  updated_by            String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@map("model_settings")
}

model ImportToolSetting {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tool_key          String   @unique
  enabled           Boolean  @default(false)
  mode              String
  endpoint          String?
  command           String?
  timeout_ms        Int?
  max_file_mb       Int?
  encrypted_api_key String?
  api_key_last4     String?
  options           Json     @default("{}")
  updated_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("import_tool_settings")
}

model ImportFormatRoute {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  format         String   @unique
  enabled        Boolean  @default(true)
  primary_tool   String
  fallback_tools String[] @default([])
  updated_by     String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("import_format_routes")
}

model McpOauthClient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  client_id      String   @unique
  client_name    String
  redirect_uris  String[] @default([])
  allowed_scopes String[] @default([])
  status         String
  created_by     String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([tenant_id])
  @@map("mcp_oauth_clients")
}

model McpOauthGrant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
