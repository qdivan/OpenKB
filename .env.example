DATABASE_URL="postgresql://openkb:openkb@localhost:55432/openkb_test?schema=public"
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
AUTH_COOKIE_NAME="openkb_session"
SESSION_TTL_DAYS="30"
EMAIL_VERIFICATION_TTL_HOURS="24"
PASSWORD_RESET_TTL_HOURS="2"

# Required by pnpm db:seed:first-admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_DISPLAY_NAME="OpenKB Admin"

DEFAULT_TENANT_NAME="Default Tenant"
DEFAULT_TENANT_SLUG="default"

# S3-compatible object storage. MinIO test defaults match deploy/docker-compose/minio.test.yml.
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_BUCKET="openkb-assets"
S3_ACCESS_KEY_ID="openkb"
S3_SECRET_ACCESS_KEY="openkb-secret"
S3_FORCE_PATH_STYLE="true"
S3_PRESIGN_TTL_SECONDS="900"

# Milvus test defaults match deploy/docker-compose/milvus.test.yml.
MILVUS_URI="localhost:59530"
MILVUS_TOKEN=""
MILVUS_DATABASE=""
MILVUS_ACTIVE_ALIAS="openkb_chunks_active"
MILVUS_COLLECTION_PREFIX="openkb_chunks"
MILVUS_ENABLE_BM25="true"
MILVUS_ENABLE_TEXT_EMBEDDING="false"
MILVUS_ENABLE_RERANK="false"
