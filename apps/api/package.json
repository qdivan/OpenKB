{
  "name": "@openkb/api",
  "private": true,
  "version": "0.3.3",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "content:test": "vitest run --config vitest.content.config.ts",
    "dev": "tsx watch src/main.ts",
    "import:test": "vitest run --config vitest.import.config.ts",
    "lint": "tsc --noEmit",
