    "@nestjs/platform-fastify": "^11.1.18",
    "@openkb/auth": "workspace:*",
    "@openkb/db": "workspace:*",
    "@openkb/editor": "workspace:*",
    "@openkb/markdown": "workspace:*",
    "@openkb/model-client": "workspace:*",
    "@openkb/milvus": "workspace:*",
    "@openkb/permissions": "workspace:*",
    "@openkb/retrieval": "workspace:*",
    "@openkb/shared": "workspace:*",
    "@openkb/storage": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
